[Unit]
Description=OCN Server Alpha (federated)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ocn
Group=ocn
WorkingDirectory=/opt/ocn-alpha
ExecStart=/opt/ocn-alpha/ocnserver -config /etc/ocn/alpha.json
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
